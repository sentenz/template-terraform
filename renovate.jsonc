{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:gitlabPipelineVersions"
  ],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "1 day",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/charts/**",
    "test/**",
    "tests/**"
  ],
  "nuget": {
    "ignorePaths": [
      "tests/**",
      "**/tests/**"
    ]
  },
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ]
  },
  "gitlabci": {
    "managerFilePatterns": [
      "/\\.gitlab-ci\\.ya?ml$/",
      "/(^|/)\\.gitlab/ci/.+\\.ya?ml$/"
    ]
  },
  "gitlabci-include": {
    "managerFilePatterns": [
      "/\\.gitlab-ci\\.ya?ml$/",
      "/(^|/)\\.gitlab/ci/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versioned Docker image references in Makefiles.",
      "managerFilePatterns": [
        "templates/*.{yml,yaml}",
        "**/templates/*.{yml,yaml}",
        "**/[Mm]akefile",
        "**/GNUMakefile",
        "**/*.mk"
      ],
      "matchStrings": [
        "(?<depName>(?:(?:[A-Za-z0-9.-]+(?::[0-9]+)?/)?[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+)):(?<currentValue>v?\\d[0-9A-Za-z_.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{else}}{{#if currentDigest}}@{{{currentDigest}}}{{/if}}{{/if}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    // ─── Terraform / OpenTofu ───────────────────────────────────────────────────────────────────
    {
      "description": "Group all minor and patch updates for Terraform/OpenTofu (providers, modules, tooling, lock file).",
      "matchManagers": [
        "terraform",
        "terraform-version",
        "terragrunt",
        "terragrunt-version",
        "tflint-plugin"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "terraform non-major",
      "semanticCommitType": "fix"
    },
    {
      "description": "Group all major updates for Terraform/OpenTofu (providers, modules, tooling, lock file).",
      "matchManagers": [
        "terraform",
        "terraform-version",
        "terragrunt",
        "terragrunt-version",
        "tflint-plugin"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ],
      "semanticCommitType": "fix",
      "automerge": false
    },
    // ─── CI/CD ──────────────────────────────────────────────────────────────────────────────────
    {
      "description": "Group CI/CD pipelines (GitHub Actions, GitLab CI).",
      "matchManagers": [
        "github-actions",
        "gitlabci",
        "gitlabci-include"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "GitHub Actions: batch non-major action updates (digest pins are kept by helpers:pinGitHubActionDigests).",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github actions"
    },
    {
      "description": "GitLab CI: batch non-major component and project include updates.",
      "matchManagers": [
        "gitlabci",
        "gitlabci-include"
      ],
      "matchDatasources": [
        "gitlab-tags"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "gitlab ci includes"
    },
    // ─── Container Images ───────────────────────────────────────────────────────────────────────
    {
      "description": "Dockerfile/Containerfile images: batch non-major updates.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "dockerfile container images"
    },
    {
      "description": "Makefile images: batch non-major updates.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/[Mm]akefile",
        "**/GNUMakefile",
        "**/*.mk"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "makefile container images"
    },
    {
      "description": "GitHub Actions container/service images: batch non-major updates.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github actions container images"
    },
    {
      "description": "GitLab CI job and service images: batch non-major updates.",
      "matchManagers": [
        "gitlabci"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "gitlab ci container images"
    },
    {
      "description": "Automerge low-risk CI tooling images (Makefile, GitHub Actions, GitLab CI) once required checks pass.",
      "matchManagers": [
        "custom.regex",
        "github-actions",
        "gitlabci"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Terraform/OpenTofu CLI images decide plan behaviour.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "**/terraform",
        "**/opentofu"
      ],
      "groupName": null,
      "automerge": false
    },
    // ─── Release-age Exceptions ─────────────────────────────────────────────────────────────────
    {
      "description": "Pinning an existing tag to its digest changes no version, so don't hold it behind the cooldown.",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "minimumReleaseAge": null
    }
  ]
}
